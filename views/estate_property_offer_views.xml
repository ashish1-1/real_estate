<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="estate_property_offer_view_list" model="ir.ui.view">
            <field name="name">estate.property.offer.view.list</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <list string="">
                    <field name="price" />
                    <field name="partner_id" />
                    <field name="validity" />
                    <field name="date_deadline" />
                    <button name="action_accept" string="" type="object" title="Accept" icon="fa-check" 
                    invisible="status != False"
                    />
                    <button name="action_refuse" string="" type="object" title="Refuse" icon="fa-times" invisible="status != False"/>
                    <field name="status" />
                </list>
            </field>
        </record>

        <record id="estate_property_offer_view_form" model="ir.ui.view">
            <field name="name">estate.property.offer.view.form</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <field name="price" />
                            <field name="partner_id" />
                            <field name="validity" />
                            <field name="date_deadline" />
                            <field name="status" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
